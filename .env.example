# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/pipeline_mep?schema=public&connection_limit=10&pool_timeout=20"

# --- Auth.js / NextAuth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-random-secret"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="http://localhost:3000"

# --- Seeding (only used by prisma/seed.ts) ---
SEED_ADMIN_USERNAME="ERP_Admin"
SEED_ADMIN_NAME="ERP Administrator"
SEED_ADMIN_EMAIL="erp_admin@awsdistribution.ae"
SEED_ADMIN_PASSWORD="ChangeMe@2026"

# --- Security ---
LOGIN_RATE_LIMIT_MAX="8"
LOGIN_RATE_LIMIT_WINDOW_MS="900000"

# Shadow DB used only by `prisma migrate dev`
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/pipeline_mep_shadow?schema=public"
